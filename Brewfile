# Terminal and shell only. No casks — this file has to install cleanly on a
# managed work machine.

brew "git"                           # newer than the Xcode's; config/git/config assumes a few modern defaults
brew "gh"                            # for GitHub interation and configuring git identity (config/git/config)

# Shell
brew "starship"                      # prompt — config/starship.toml, init in zshrc
brew "zoxide"                        # replaces cd — init in zshrc
brew "fzf"                           # fuzzy finder, ctrl-r/ctrl-t — init + theming in zshrc
brew "zsh-autosuggestions"           # sourced in zshrc
brew "zsh-fast-syntax-highlighting"  # sourced in zshrc (last)

# Core CLI
brew "bat"                           # MANPAGER + BAT_THEME in zshrc
brew "fd"                            # feeds fzf's file/dir commands (zshrc)
brew "eza"                           # nicer ls; nothing depends on it
brew "ripgrep"                       # nicer grep; nothing depends on it
brew "git-delta"                     # git's pager + interactive diffFilter (config/git/config)

brew "herdr"                         # terminal multiplexer
