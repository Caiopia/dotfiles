#!/usr/bin/env bash
# Curl-able entry point:
#   curl -fsSL https://raw.githubusercontent.com/Caiopia/dotfiles/main/bootstrap | bash
set -euo pipefail

REPO_URL="${DOTFILES_REPO:-https://github.com/Caiopia/dotfiles.git}"
DOTFILES_DIR="${DOTFILES_DIR:-${DEV_HOME:-$HOME/Developer}/dotfiles}"

if ! command -v git &>/dev/null; then
  echo "git not found — installing the Xcode Command Line Tools."
  xcode-select --install
  echo "Re-run this once the installer finishes."
  exit 1
fi

if [[ -d "${DOTFILES_DIR}/.git" ]]; then
  echo "--- Updating ${DOTFILES_DIR} ---"
  # Fail loudly on a dirty tree rather than stashing behind your back: this is
  # a live edit surface, not just a deploy target.
  if ! git -C "${DOTFILES_DIR}" diff --quiet || ! git -C "${DOTFILES_DIR}" diff --cached --quiet; then
    echo "ERROR: ${DOTFILES_DIR} has uncommitted changes." >&2
    echo "Commit or stash them, then re-run." >&2
    exit 1
  fi
  git -C "${DOTFILES_DIR}" pull --ff-only
else
  echo "--- Cloning into ${DOTFILES_DIR} ---"
  mkdir -p "$(dirname "${DOTFILES_DIR}")"
  git clone "${REPO_URL}" "${DOTFILES_DIR}"
fi

if ! command -v brew &>/dev/null; then
  echo "--- Installing Homebrew ---"
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  if [[ "$(uname -m)" == "arm64" ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
  else
    eval "$(/usr/local/bin/brew shellenv)"
  fi
fi

exec "${DOTFILES_DIR}/install" "$@"
